# ====================================================================
# CHSL Mastery — SSC CHSL 2026 Complete Preparation Platform
# Production & Local Environment Configuration
# ====================================================================

# Frontend Variables (Vite)
VITE_APP_TITLE=CHSL Mastery
VITE_TARGET_EXAM=SSC CHSL 2026
VITE_DEFAULT_TIER=tier1

# Backend Variables (Optional: Required only if running Flask server)
PORT=5000
SECRET_KEY=change-this-to-a-cryptographically-random-secret-key-32-chars
FRONTEND_URL=https://chslmastery.vercel.app
SESSION_COOKIE_SECURE=true
DATABASE_PATH=chsl_mastery.db

# SMTP Configuration (Optional: for cloud verification OTPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=CHSL Mastery <no-reply@chslmastery.gov.in>
SMTP_USE_TLS=true
