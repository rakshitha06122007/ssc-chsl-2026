# ====================================================================
# TrustHire AI — Backend Configuration (.env.example)
# Copy this file to .env and adjust the values for your environment.
# Never commit .env with real credentials into public repositories.
# ====================================================================

# Server & Security
PORT=5000
SECRET_KEY=change-this-to-a-cryptographically-random-secret-key-32-chars
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
DATABASE_PATH=trusthire.db

# Production / Cross-Origin CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Delivery via SMTP (e.g. Gmail, SendGrid, Mailgun)
# For Gmail: Enable 2-Step Verification on your Google Account, then generate
# an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM=TrustHire AI <no-reply@trusthire.ai>
SMTP_USE_TLS=true

# AI Engine Provider (heuristic, openai, gemini)
AI_PROVIDER=heuristic
AI_API_KEY=
